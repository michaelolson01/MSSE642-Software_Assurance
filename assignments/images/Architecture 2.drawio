        <mxCell id="ZdsZa0t-H0PflO7Lm8Bm-19" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Admin Only&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Access Treasury Pool&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
