        <mxCell id="ZdsZa0t-H0PflO7Lm8Bm-20" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Member Services&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;Register For Events&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;Edit Personal Profile&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;align=center;fillColor=default;strokeColor=default;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="802.5" y="-225" width="165" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ZdsZa0t-H0PflO7Lm8Bm-26" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Authentication&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font size=&quot;1&quot;&gt;Member Client Users - Hiking Club Members&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;1&quot;&gt;Admin Client Users - Trip Leaders and Admin&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;align=center;fillColor=default;strokeColor=default;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="970" y="-435" width="225" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ZdsZa0t-H0PflO7Lm8Bm-27" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Guest Browsing&lt;/span&gt;&lt;/h1&gt;&lt;div style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;View items only&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;align=center;strokeColor=#FFFFFF;strokeWidth=2;fillColor=default;" vertex="1" parent="1">
          <mxGeometry x="780" y="-425" width="165" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ZdsZa0t-H0PflO7Lm8Bm-30" value="&lt;h1 style=&quot;text-align: center; margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;Trip Leader&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;a. Post new events.&lt;/div&gt;&lt;div&gt;b. Perform all CRUD operations on events they have posted, but not events created by other trip leaders.&lt;/div&gt;&lt;div&gt;c. Mark the completion status of registered members for their events: &quot;Completed Event,&quot; &quot;Did Not Complete,&quot; &quot;No Show.&quot;&lt;/div&gt;&lt;div&gt;d. Select members from the wait list to the event manually (trip leader can pick and choose which members to accept).&lt;/div&gt;&lt;div&gt;e. Drop registered members from an event.&lt;/div&gt;&lt;div&gt;f. See information about members not available to anyone except trip leaders (medical information, &quot;private&quot; notes written about members by trip leaders).&lt;/div&gt;&lt;div&gt;g. Run reports on members (e.g., how many times did a member register for an event and not show up without canceling, how many times does a member register for an event and cancel, etc.).&lt;/div&gt;&lt;div&gt;h. Set maximum and minimum numbers for their events only.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;align=left;strokeColor=default;spacingLeft=15;spacingRight=15;" vertex="1" parent="1">
          <mxGeometry x="-672.5" y="900" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ZdsZa0t-H0PflO7Lm8Bm-31" value="&lt;h1 style=&quot;text-align: center; margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;System Admin&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;a. Create &amp;amp; disable user accounts&lt;/div&gt;&lt;div&gt;b. Create &amp;amp; disable trip leader accounts&lt;/div&gt;&lt;/div&gt;&lt;div&gt;c. Run sanity checks for database security&lt;/div&gt;&lt;div&gt;d. Setup payment portal to receive payments for paid trips&lt;/div&gt;&lt;div&gt;e. Has full access to treasury&lt;/div&gt;&lt;div&gt;f. Can run reports for all trips.&lt;/div&gt;&lt;div&gt;g. Can withdraw money to pay for trips.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;align=left;strokeColor=default;spacingLeft=15;spacingRight=15;" vertex="1" parent="1">
          <mxGeometry x="-252.5" y="900" width="340" height="190" as="geometry" />
